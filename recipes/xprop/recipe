name=xprop
version=1.2.8
desc="свойства окон (отладка)"
source=(https://www.x.org/pub/individual/app/xprop-$version.tar.xz)
depends=(libX11)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/xprop-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
