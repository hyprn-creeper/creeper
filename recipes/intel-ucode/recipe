name=intel-ucode
version=20260925
desc="микрокод процессоров Intel (исправления ошибок и уязвимостей CPU) + /boot/intel-ucode.img"
source=(intel-ucode-$version.tar.gz::https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/refs/tags/microcode-$version.tar.gz)
depends=()

build() {
  # ранняя загрузка: несжатый cpio с одним файлом, GRUB грузит его как initrd
  mkdir -p early/kernel/x86/microcode
  cat intel-ucode/* > early/kernel/x86/microcode/GenuineIntel.bin
  # cpio в LFS нет — формат newc пишем на python
  python3 - early intel-ucode.img << 'PY'
import os, sys
root, out = sys.argv[1], sys.argv[2]
ents = []
for d, dirs, files in os.walk(root):
    dirs.sort()
    rel = os.path.relpath(d, root)
    if rel != '.': ents.append((rel, None))
    for f in sorted(files): ents.append((os.path.join(rel, f) if rel != '.' else f, os.path.join(d, f)))
def hdr(name, mode, data, ino):
    n = name.encode() + b'\0'
    h = b'070701' + b''.join(b'%08X' % v for v in (ino, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(n), 0))
    b = h + n; b += b'\0' * (-len(b) % 4); b += data; b += b'\0' * (-len(b) % 4)
    return b
buf = b''
for i, (name, path) in enumerate(ents, 1):
    buf += hdr(name, 0o40755, b'', i) if path is None else hdr(name, 0o100644, open(path, 'rb').read(), i)
buf += hdr('TRAILER!!!', 0, b'', 0)
buf += b'\0' * (-len(buf) % 512)
open(out, 'wb').write(buf)
PY
}
package() {
  install -dm755 "$PKG/usr/lib/firmware/intel-ucode"
  install -m644 intel-ucode/* "$PKG/usr/lib/firmware/intel-ucode/"
  install -Dm644 intel-ucode.img "$PKG/boot/intel-ucode.img"
  install -Dm644 license "$PKG/usr/share/licenses/intel-ucode/license" 2>/dev/null || true
}
post_install() {
  echo "Чтобы микрокод грузился рано, в запись LFS в GRUB добавь строку после linux ...:"
  echo "    initrd /boot/intel-ucode.img"
  echo "(путь — как у vmlinuz в той же записи). Проверка после загрузки: dmesg | grep microcode"
  true
}
