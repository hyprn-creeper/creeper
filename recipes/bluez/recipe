name=bluez
version=5.88
desc="Bluetooth: bluetoothd и bluetoothctl"
source=(https://www.kernel.org/pub/linux/bluetooth/bluez-$version.tar.xz)
depends=(dbus glib)
backup=(etc/bluetooth/main.conf)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
              --disable-manpages --enable-library --disable-systemd \
              --disable-obex --disable-cups --disable-mesh --disable-midi
  make
}
package() {
  make DESTDIR="$PKG" install
  install -dm755 "$PKG/usr/sbin"; ln -sf ../libexec/bluetooth/bluetoothd "$PKG/usr/sbin/bluetoothd"
  install -dm755 "$PKG/etc/bluetooth" "$PKG/etc/rc.d/init.d"
  install -m644 src/main.conf "$PKG/etc/bluetooth/main.conf"
  # включать адаптер сам при загрузке
  sed -i 's/^#\?AutoEnable *=.*/AutoEnable=true/' "$PKG/etc/bluetooth/main.conf"
  cat > "$PKG/etc/rc.d/init.d/bluetooth" << 'EOS'
#!/bin/sh
### BEGIN INIT INFO
# Provides:            bluetooth
# Required-Start:      dbus
# Default-Start:       3 4 5
# Default-Stop:        0 1 2 6
# Short-Description:   Bluetooth daemon
### END INIT INFO
. /lib/lsb/init-functions
case "$1" in
  start)  log_info_msg "Starting Bluetooth daemon..."
          /usr/libexec/bluetooth/bluetoothd &
          sleep 1; /usr/bin/rfkill unblock bluetooth 2>/dev/null; log_success_msg ;;
  stop)   log_info_msg "Stopping Bluetooth daemon..."
          killall bluetoothd 2>/dev/null; log_success_msg ;;
  restart) $0 stop; sleep 1; $0 start ;;
  status) pidof bluetoothd >/dev/null && echo "bluetoothd работает" || echo "bluetoothd не запущен" ;;
  *)      echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
EOS
  chmod 754 "$PKG/etc/rc.d/init.d/bluetooth"
}
post_install() {
  for r in 3 4 5; do ln -sf ../init.d/bluetooth /etc/rc.d/rc$r.d/S35bluetooth 2>/dev/null; done
  for r in 0 1 2 6; do ln -sf ../init.d/bluetooth /etc/rc.d/rc$r.d/K25bluetooth 2>/dev/null; done
  [ -S /run/dbus/system_bus_socket ] && /etc/rc.d/init.d/bluetooth start >/dev/null 2>&1
  echo "Подключение наушников: bluetoothctl → scan on → pair АДРЕС → trust АДРЕС → connect АДРЕС"
  true
}
pre_blow() { /etc/rc.d/init.d/bluetooth stop >/dev/null 2>&1; rm -f /etc/rc.d/rc?.d/[SK]*bluetooth; true; }
