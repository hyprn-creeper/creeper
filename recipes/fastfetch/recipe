name=fastfetch
version=2.70.0
desc="сведения о системе с логотипом (собранный из исходников)"
url=https://github.com/fastfetch-cli/fastfetch
source=(fastfetch-$version.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz)
depends=(cmake)

build() {
  cmake -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=OFF -DENABLE_SYSTEM_YYJSON=OFF
  ninja -C build -j"$JOBS"
}
package() { DESTDIR="$PKG" ninja -C build install; }
post_install() {
  if [ -e /usr/local/bin/fastfetch ]; then
    echo "Старый fastfetch (готовая программа с GitHub) лежит в /usr/local/bin и перекрывает новый."
    echo "Убрать: sudo rm /usr/local/bin/fastfetch; sudo rm -rf /usr/local/share/fastfetch"
  fi
}
