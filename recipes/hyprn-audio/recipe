name=hyprn-audio
version=1.0
release=3
desc="настройка звука Hyprn: USB-гарнитуры в PulseAudio + команда mic (проверка микрофона)"
source=()
depends=(pulseaudio alsa-utils)

build() { :; }
package() {
  install -dm755 "$PKG/etc/pulse/daemon.conf.d" "$PKG/usr/bin"
  # не выключаться без клиентов — иначе ручные настройки пропадают
  echo 'exit-idle-time = -1' > "$PKG/etc/pulse/daemon.conf.d/90-hyprn.conf"
  cat > "$PKG/usr/bin/mic" << 'EOS'
#!/bin/sh
# mic — подключить все звуковые карты к PulseAudio, выбрать USB-микрофон, проверить запись
pactl info >/dev/null 2>&1 || { pulseaudio --start; sleep 2; }
# карты ALSA, которых PulseAudio не видит, — подключить
for n in $(sed -n 's/^ *\([0-9]*\) \[.*/\1/p' /proc/asound/cards); do
  pactl list cards | grep -q "alsa.card = \"$n\"" || pactl load-module module-alsa-card device_id="$n" >/dev/null 2>&1
done
# включить микрофон и наушники в микшерах всех карт
for c in $(sed -n 's/^ *\([0-9]*\) \[.*/\1/p' /proc/asound/cards); do
  # как в Arch: запись около +3 dB (на максимуме голос тонет в шуме), самопрослушивание выкл
  amixer -q -c "$c" sset Mic capture 10% cap 2>/dev/null
  amixer -q -c "$c" sset Mic playback 0% mute 2>/dev/null
  amixer -q -c "$c" sset Capture 80% cap 2>/dev/null
  amixer -q -c "$c" sset Headphone 80% unmute 2>/dev/null
done
src=$(pactl list short sources | awk '/alsa_input/ && !/pci/{print $2; exit}')
[ -n "$src" ] || src=$(pactl list short sources | awk '/alsa_input/{print $2; exit}')
snk=$(pactl list short sinks | awk '/alsa_output/ && !/pci/{print $2; exit}')
[ -n "$src" ] && pactl set-default-source "$src" && pactl set-source-mute "$src" 0
[ -n "$snk" ] && pactl set-default-sink "$snk"
echo "микрофон: ${src:-не найден}"
echo "вывод:    $(pactl info | sed -n 's/^Default Sink: //p')"
[ "$1" = "-q" ] && exit 0
echo "Говори 5 секунд..."
timeout 5 parecord /tmp/mic-test.wav
echo "Воспроизвожу запись"
paplay /tmp/mic-test.wav
echo "Слышно себя — перезапусти Discord и выбери этот микрофон в «Голос и видео»."
EOS
  chmod 755 "$PKG/usr/bin/mic"
}
post_install() {
  echo "Дальше (без sudo): pulseaudio -k; mic"
  true
}
