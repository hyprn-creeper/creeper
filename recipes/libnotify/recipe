name=libnotify
version=0.8.9
desc="libnotify — уведомления (notify-send)"
source=(https://download.gnome.org/sources/libnotify/0.8/libnotify-$version.tar.xz)
depends=(glib gdk-pixbuf)

build() {
  mkdir -p build && cd build
  meson setup .. --prefix=/usr --buildtype=release -D tests=false -D introspection=disabled \
        -D man=false -D gtk_doc=false -D docbook_docs=disabled
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; }
