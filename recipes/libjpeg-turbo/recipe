name=libjpeg-turbo
version=3.0.1
desc="картинки JPEG"
source=(https://downloads.sourceforge.net/libjpeg-turbo/libjpeg-turbo-$version.tar.gz)
depends=(cmake)

build() {
  mkdir -p build && cd build
  cmake -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=RELEASE -D ENABLE_STATIC=FALSE \
        -D CMAKE_INSTALL_DEFAULT_LIBDIR=lib -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -D CMAKE_SKIP_INSTALL_RPATH=ON -D WITH_SIMD=OFF \
        -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libjpeg-turbo-$version ..
  make
}
package() { cd build && make DESTDIR="$PKG" install; }
