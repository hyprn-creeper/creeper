name=mc
version=4.8.33
desc="Midnight Commander — двухпанельный файловый менеджер"
source=(http://ftp.midnight-commander.org/mc-$version.tar.xz)
depends=(glib)

build() { ./configure --prefix=/usr --sysconfdir=/etc --with-screen=ncurses --enable-charset; make; }
package() { make DESTDIR="$PKG" install; }
