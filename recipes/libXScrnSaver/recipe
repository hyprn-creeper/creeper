name=libXScrnSaver
version=1.2.4
desc="расширение MIT-SCREEN-SAVER"
source=(https://www.x.org/pub/individual/lib/libXScrnSaver-$version.tar.xz)
depends=(libXext)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/libXScrnSaver-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
