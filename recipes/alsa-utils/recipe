name=alsa-utils
version=1.2.14
release=2
desc="звук ALSA: alsamixer, amixer, arecord, aplay, alsactl (сохранение громкости)"
source=(https://www.alsa-project.org/files/pub/utils/alsa-utils-$version.tar.bz2)
depends=(alsa-lib)

build() {
  ./configure --prefix=/usr --disable-alsaconf --disable-bat --disable-xmlto \
              --with-curses=ncursesw --with-systemdsystemunitdir=no
  make
}
package() {
  make DESTDIR="$PKG" install
  install -dm755 "$PKG/var/lib/alsa" "$PKG/etc/rc.d/init.d"
  # громкость/микрофон: восстанавливается udev-правилом при появлении карты,
  # сохраняется этим скриптом при выключении
  cat > "$PKG/etc/rc.d/init.d/alsa" << 'EOS'
#!/bin/sh
### BEGIN INIT INFO
# Provides:            alsa
# Default-Start:       2 3 4 5
# Default-Stop:        0 1 6
# Short-Description:   restore/store ALSA mixer state
### END INIT INFO
. /lib/lsb/init-functions
case "$1" in
  start) log_info_msg "Restoring ALSA mixer..."; /usr/sbin/alsactl restore >/dev/null 2>&1; log_success_msg ;;
  stop)  log_info_msg "Storing ALSA mixer..."; /usr/sbin/alsactl store; evaluate_retval ;;
  *)     echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
EOS
  chmod 754 "$PKG/etc/rc.d/init.d/alsa"
}
post_install() {
  for r in 0 6; do ln -sf ../init.d/alsa /etc/rc.d/rc$r.d/K35alsa 2>/dev/null; done
  ln -sf ../init.d/alsa /etc/rc.d/rc3.d/S95alsa 2>/dev/null
  ln -sf ../init.d/alsa /etc/rc.d/rc5.d/S95alsa 2>/dev/null
  # если звуковая карта есть — включить запись и динамики
  if [ -e /dev/snd/controlC0 ]; then
    amixer -q -c0 sset Master 80% unmute 2>/dev/null || true
    amixer -q -c0 sset Speaker 100% unmute 2>/dev/null || true
    amixer -q -c0 sset Capture 80% cap 2>/dev/null || true
    amixer -q -c0 sset 'Internal Mic Boost' 1 2>/dev/null || true
    alsactl store 2>/dev/null || true
  fi
  echo "Микшер: alsamixer (F4 — запись; пробел включает Capture). Проверка микрофона: arecord -d5 /tmp/t.wav && aplay /tmp/t.wav"
  true
}
pre_blow() { rm -f /etc/rc.d/rc?.d/[SK]*alsa; true; }
