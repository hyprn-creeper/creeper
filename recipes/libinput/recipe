name=libinput
version=1.29.0
desc="клавиатура, мышь, тачпад"
source=(https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.gz)
depends=(libevdev mtdev)

build() {
  mkdir -p build && cd build
  meson setup --prefix=/usr --buildtype=release -D debug-gui=false -D tests=false -D libwacom=false -D udev-dir=/usr/lib/udev ..
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; }
