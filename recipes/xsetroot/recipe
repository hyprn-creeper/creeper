name=xsetroot
version=1.1.3
desc="фон рабочего стола, имя окна (статус dwm)"
source=(https://www.x.org/pub/individual/app/xsetroot-$version.tar.xz)
depends=(libXmu libXcursor libXfixes xbitmaps)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/xsetroot-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
