name=glib
version=2.84.4
desc="GLib — основа GTK и GNOME"
source=(https://download.gnome.org/sources/glib/2.84/glib-$version.tar.xz)
depends=(pcre2 libxml2)

build() {
  mkdir -p build && cd build
  meson setup .. --prefix=/usr --buildtype=release --wrap-mode=nofallback \
        -D introspection=disabled -D glib_debug=disabled -D man-pages=disabled \
        -D sysprof=disabled -D tests=false
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; }
