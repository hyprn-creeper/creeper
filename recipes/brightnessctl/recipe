name=brightnessctl
version=0.5.1
release=2
desc="яркость экрана и подсветки клавиатуры (brightnessctl set 10%+)"
source=(brightnessctl-$version.tar.gz::https://github.com/Hummer12007/brightnessctl/archive/refs/tags/$version.tar.gz)
depends=()

build() {
  # без systemd/logind: собираем напрямую, права даёт udev-правило (группа video)
  gcc -O2 -std=c99 -Wall -D_POSIX_C_SOURCE=200809L -DVERSION=\"$version\" brightnessctl.c -lm -o brightnessctl
}
package() {
  # setuid: без logind udev-правило срабатывает не всегда, а писать в /sys/class/backlight может только root
  install -Dm4755 brightnessctl "$PKG/usr/bin/brightnessctl"
  install -Dm644 90-brightnessctl.rules "$PKG/usr/lib/udev/rules.d/90-brightnessctl.rules"
  [ -f brightnessctl.1 ] && install -Dm644 brightnessctl.1 "$PKG/usr/share/man/man1/brightnessctl.1"
  true
}
post_install() {
  udevadm control --reload 2>/dev/null; udevadm trigger -s backlight 2>/dev/null
  echo "Нужна группа video (у hyprn уже есть). Пример: brightnessctl set 50%"
  true
}
