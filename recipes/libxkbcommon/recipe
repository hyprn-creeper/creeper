name=libxkbcommon
version=1.11.0
desc="раскладки клавиатуры для программ"
source=(libxkbcommon-$version.tar.gz::https://github.com/xkbcommon/libxkbcommon/archive/xkbcommon-$version/libxkbcommon-$version.tar.gz)
depends=(xkeyboard-config libxcb libxml2)

build() {
  mkdir -p build && cd build
  meson setup .. --prefix=/usr --buildtype=release -D enable-docs=false -D enable-wayland=false
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; }
