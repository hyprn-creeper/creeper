name=openssh
version=10.0p1
desc="SSH: клиент ssh/scp/sftp и сервер sshd"
url=https://www.openssh.com/
source=(https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$version.tar.gz)
depends=()
backup=(etc/ssh/sshd_config etc/ssh/ssh_config)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc/ssh \
              --with-privsep-path=/var/lib/sshd \
              --with-default-path=/usr/bin \
              --with-superuser-path=/usr/sbin:/usr/bin \
              --with-pid-dir=/run
  make
}
package() {
  make DESTDIR="$PKG" install
  install -v -m755 contrib/ssh-copy-id "$PKG/usr/bin"
  install -v -m644 contrib/ssh-copy-id.1 "$PKG/usr/share/man/man1"
  install -v -dm700 "$PKG/var/lib/sshd"
  # запуск сервера (SysV). Включается вручную — см. post_install
  install -dm755 "$PKG/etc/rc.d/init.d"
  cat > "$PKG/etc/rc.d/init.d/sshd" << 'EOS'
#!/bin/sh
### BEGIN INIT INFO
# Provides:            sshd
# Required-Start:      $network
# Default-Start:       3 4 5
# Default-Stop:        0 1 2 6
# Short-Description:   OpenSSH server
### END INIT INFO
. /lib/lsb/init-functions
case "$1" in
  start)   log_info_msg "Starting SSH Server..."
           /usr/sbin/sshd; evaluate_retval ;;
  stop)    log_info_msg "Stopping SSH Server..."
           [ -s /run/sshd.pid ] && kill "$(cat /run/sshd.pid)"; evaluate_retval ;;
  restart) $0 stop; sleep 1; $0 start ;;
  status)  [ -s /run/sshd.pid ] && kill -0 "$(cat /run/sshd.pid)" 2>/dev/null && echo "sshd работает" || echo "sshd не запущен" ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
EOS
  chmod 754 "$PKG/etc/rc.d/init.d/sshd"
}
post_install() {
  getent group sshd >/dev/null || groupadd -g 50 sshd
  getent passwd sshd >/dev/null || useradd -c 'sshd PrivSep' -d /var/lib/sshd -g sshd -s /bin/false -u 50 sshd
  chown root:sys /var/lib/sshd 2>/dev/null || true
  ssh-keygen -A
  echo "SSH-клиент готов. Сервер sshd выключен; включить при загрузке:"
  echo "  sudo ln -sf ../init.d/sshd /etc/rc.d/rc3.d/S30sshd && sudo /etc/rc.d/init.d/sshd start"
}
pre_blow() {
  [ -s /run/sshd.pid ] && kill "$(cat /run/sshd.pid)" 2>/dev/null
  rm -f /etc/rc.d/rc?.d/S30sshd
  true
}
