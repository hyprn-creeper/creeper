name=at-spi2-core
version=2.56.4
desc="доступность (atk, at-spi) — нужна GTK и Electron"
source=(https://download.gnome.org/sources/at-spi2-core/2.56/at-spi2-core-$version.tar.xz)
depends=(dbus glib libX11 libXtst libXi libxml2)

build() {
  mkdir -p build && cd build
  meson setup .. --prefix=/usr --buildtype=release -D gtk2_atk_adaptor=false \
        -D introspection=disabled -D docs=false -D systemd_user_dir=/tmp/atspi-unused
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; rm -rf "${PKG:?}/tmp"; }
