name=xset
version=1.2.5
desc="настройки X (клавиатура, экран)"
source=(https://www.x.org/pub/individual/app/xset-$version.tar.xz)
depends=(libXmu libXext libXfixes)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/xset-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
