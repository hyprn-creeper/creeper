name=libconfig
version=1.8.3
desc="libconfig — чтение файлов настроек (для picom)"
source=(libconfig-$version.tar.gz::https://github.com/hyperrealm/libconfig/archive/refs/tags/v$version.tar.gz)
depends=()

build() {
  cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF
  cmake --build build -j"$JOBS"
}
package() { DESTDIR="$PKG" cmake --install build; }
