name=libICE
version=1.1.2
desc="Inter-Client Exchange"
source=(https://www.x.org/pub/individual/lib/libICE-$version.tar.xz)
depends=(xtrans xorgproto)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/libICE-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
