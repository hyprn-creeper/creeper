name=fribidi
version=1.0.16
desc="текст справа налево (нужно pango)"
source=(https://github.com/fribidi/fribidi/releases/download/v$version/fribidi-$version.tar.xz)
depends=()

build() {
  mkdir -p build && cd build
  meson setup .. --prefix=/usr --buildtype=release -D docs=false -D tests=false
  ninja -j"$JOBS"
}
package() { cd build && DESTDIR="$PKG" ninja install; }
