name=xbitmaps
version=1.1.3
desc="стандартные картинки X11"
source=(https://www.x.org/pub/individual/data/xbitmaps-$version.tar.xz)
depends=(util-macros)

build() {
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --docdir=/usr/share/doc/xbitmaps-$version 
  make
}
package() { make DESTDIR="$PKG" install; }
