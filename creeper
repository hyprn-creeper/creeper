#!/bin/bash
# creeper — пакетный менеджер Hyprn LFS
#   creeper install <пакет...>   поставить (готовый бинарник или сборка из исходников)
#   creeper blow <пакет...>      взорвать (удалить)
#   creeper help                 все команды
#
# Рецепты:     /var/lib/creeper/recipes/<пакет>/recipe
# Установлено: /var/lib/creeper/installed/<пакет>/{version,release,files,dirs,sha256,depends,backup,reason,date,recipe}

CREEPER_VERSION=0.4

# ROOT пустой = настоящая система. CREEPER_ROOT — только для тестов.
ROOT=${CREEPER_ROOT:-}
CONF=$ROOT/etc/creeper.conf
[ -r "$CONF" ] && . "$CONF"

RECIPES=${RECIPES:-$ROOT/var/lib/creeper/recipes}
DB=$ROOT/var/lib/creeper/installed
SUMS=$ROOT/var/lib/creeper/sums
SOURCES=${SOURCES:-$ROOT/var/cache/creeper/sources}
BINCACHE=${BINCACHE:-$ROOT/var/cache/creeper/bin}
WORK=${WORK:-$ROOT/var/tmp/creeper}
LOGS=$ROOT/var/log/creeper
HISTORY=$LOGS/history.log
: "${BINREPO:=}"              # https://github.com/USER/creeper/releases/download/bin
: "${CREEPER_KEEPBIN:=1}"     # 1 = хранить собранные пакеты в $BINCACHE
: "${CREEPER_STRIP:=1}"
: "${CREEPER_CHECK:=0}"
: "${CREEPER_MINFREE_MB:=3000}"
# ферма: репозиторий берём из BINREPO (https://github.com/OWNER/REPO/releases/download/bin)
: "${FARM_REPO:=$(printf '%s' "$BINREPO" | sed -n 's#^https://github.com/\([^/]*/[^/]*\)/releases/.*#\1#p')}"
: "${FARM_WORKFLOW:=build.yml}"
: "${FARM_REF:=main}"
: "${FARM_API:=https://api.github.com}"
: "${FARM_POLL:=15}"
FARM_TOKEN_FILE=${FARM_TOKEN_FILE:-$ROOT/etc/creeper/github-token}
# потоки сборки: CREEPER_JOBS, иначе -jN из MAKEFLAGS, иначе все ядра
if [ -z "${CREEPER_JOBS:-}" ]; then
  CREEPER_JOBS=$(printf '%s' "${MAKEFLAGS:-}" | sed -n 's/.*-j *\([0-9][0-9]*\).*/\1/p')
  [ -n "$CREEPER_JOBS" ] || CREEPER_JOBS=$(nproc 2>/dev/null || echo 2)
fi
JOBS=$CREEPER_JOBS
MAKEFLAGS="-j$JOBS"
export MAKEFLAGS JOBS CMAKE_BUILD_PARALLEL_LEVEL=$JOBS

# ---------- оформление ----------
if [ -t 1 ]; then CG=$'\e[1;32m'; CR=$'\e[1;31m'; CY=$'\e[1;33m'; CB=$'\e[1m'; CN=$'\e[0m'
else CG=; CR=; CY=; CB=; CN=; fi
say()  { printf '%s==>%s %s\n' "$CG" "$CN" "$*"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '%s!!>%s %s\n' "$CY" "$CN" "$*" >&2; }
die()  { printf '%sxx>%s %s\n' "$CR" "$CN" "$*" >&2; exit 1; }

usage() {
cat <<EOF
${CG}creeper${CN} $CREEPER_VERSION — Ссссс... пакетный менеджер Hyprn LFS

 Установка и удаление
  install <пакет...>    поставить вместе с зависимостями
      --reinstall         переставить ту же версию (из кэша/репозитория — быстро)
      --rebuild           собрать заново из исходников (даже если стоит)
      --source            всё только из исходников, без бинарников
      --check             запускать тесты пакетов
  blow <пакет...>       взорвать (удалить)
      -y                  не спрашивать подтверждение
      --force             даже если от него зависят другие
      --purge             удалить и сохранённые конфиги
  upgrade               обновить всё, у чего рецепт новее
  autoremove            взорвать зависимости, которые больше никому не нужны
  fetch <пакет...>      только скачать (потом можно ставить без сети)

 Сведения
  list                  установленные пакеты     orphans   ненужные зависимости
  search [слово]        доступные рецепты         info <п>  о пакете
  deps <пакет>          дерево зависимостей       files <п> файлы пакета
  owns <файл>           чей это файл              log <п>   лог сборки
  verify [пакет...]     проверить файлы по sha256 (нужен sudo)
  history               что ставилось и удалялось

 Ферма (сборка на GitHub прямо из LFS)
  farm build <п...>     собрать на GitHub, дождаться и поставить
      --rebuild           пересобрать, даже если бинарник уже есть
      --no-install        только собрать
  farm send <п|файл>    отправить свой рецепт в репозиторий
  farm status           последние сборки       farm log   лог последней сборки
  farm token            сохранить токен GitHub (один раз)

 Обслуживание
  sync                  обновить рецепты из репозитория
  self-update           обновить сам creeper из репозитория
  clean [--all]         убрать временные файлы (--all: и старые исходники/бинарники)
  new <url>             заготовка рецепта по ссылке на исходники
  pack <пакет>          бинарник из установленного пакета
  index                 строки index.txt (для фермы)

  Рецепты:   $RECIPES
  Бинарники: $BINCACHE
  Репозиторий: ${BINREPO:-не задан}   Потоки сборки: $JOBS
EOF
}

need_root() { [ "$(id -u)" -eq 0 ] || die "нужны права root: sudo creeper $*"; }

lock() {
  mkdir -p "$ROOT/run" 2>/dev/null
  exec 9>"$ROOT/run/creeper.lock" || die "не могу создать замок $ROOT/run/creeper.lock"
  flock -n 9 || die "creeper уже работает в другом окне"
}

history_add() { mkdir -p "$LOGS" && printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$HISTORY"; }

# /bin /sbin /lib в LFS — ссылки на /usr/...; храним пути в одном виде
normalize() { sed -e 's#^/bin/#/usr/bin/#' -e 's#^/sbin/#/usr/sbin/#' -e 's#^/lib/#/usr/lib/#'; }

recipe_file() { echo "$RECIPES/$1/recipe"; }
have_recipe() { [ -r "$(recipe_file "$1")" ]; }
installed()   { [ -f "$DB/$1/version" ]; }
inst_version(){ cat "$DB/$1/version" 2>/dev/null; }
inst_release(){ cat "$DB/$1/release" 2>/dev/null || echo 1; }
check_recipe(){ bash -n "$(recipe_file "$1")" 2>/dev/null || die "рецепт '$1' с ошибкой: bash -n $(recipe_file "$1")"; }

# значение переменной/массива из рецепта (в подоболочке, чтобы не мусорить)
meta() { meta_f "$(recipe_file "$1")" "$2"; }
meta_f() { # meta_f <файл> <переменная>   (массивы — по элементу на строку)
  ( . "$1" >/dev/null 2>&1 || exit 1
    declare -n v="$2" 2>/dev/null || exit 0
    if [ "$(declare -p "$2" 2>/dev/null | cut -c1-10)" = "declare -a" ]; then
      [ ${#v[@]} -gt 0 ] && printf '%s\n' "${v[@]}"
    else
      [ -n "${v:-}" ] && printf '%s\n' "$v"
    fi
    exit 0 )
}
pkgrel()  { local r; r=$(meta "$1" release); echo "${r:-1}"; }
binfile() { echo "$1-$2-$3.tar.zst"; }

# source-строка: "имя::url" или просто "url"
src_name() { case $1 in *::*) echo "${1%%::*}";; *) basename "${1%%\?*}";; esac; }
src_url()  { case $1 in *::*) echo "${1#*::}";; *) echo "$1";; esac; }

# ---------- зависимости ----------
RESOLVED=(); declare -A SEEN=() VISITING=() TARGET=() METHOD=()
resolve() { # resolve <пакет> — порядок установки (зависимости раньше)
  local p=$1 d
  [ -n "${SEEN[$p]:-}" ] && return 0
  [ -n "${VISITING[$p]:-}" ] && die "круговая зависимость через $p"
  have_recipe "$p" || die "нет рецепта '$p' (обнови рецепты: sudo creeper sync)"
  check_recipe "$p"
  VISITING[$p]=1
  for d in $(meta "$p" depends); do
    installed "$d" && continue
    resolve "$d"
  done
  unset "VISITING[$p]"; SEEN[$p]=1; RESOLVED+=("$p")
}

# ---------- скачивание ----------
# запасные адреса для известных серверов
alt_urls() {
  local u=$1
  echo "$u"
  case $u in
    https://ftp.gnu.org/gnu/*|http://ftp.gnu.org/gnu/*) echo "https://ftpmirror.gnu.org/${u#*ftp.gnu.org/gnu/}" ;;
    https://www.kernel.org/pub/*) echo "https://mirrors.edge.kernel.org/pub/${u#https://www.kernel.org/pub/}" ;;
    https://ftp.openbsd.org/pub/*) echo "https://cdn.openbsd.org/pub/${u#https://ftp.openbsd.org/pub/}" ;;
  esac
}

download() { # download <url> <файл>
  local url=$1 out=$2 u bar=-sS
  [ -t 2 ] && bar=-#
  rm -f "$out.part"
  if ! command -v curl >/dev/null && ! command -v wget >/dev/null; then
    die "нечем скачать $url
    В системе нет curl/wget. Скачай файл в Arch и положи в /mnt/lfs${out#$ROOT}"
  fi
  while read -r u; do
    if command -v curl >/dev/null; then
      curl -fL $bar --retry 3 --retry-delay 2 --connect-timeout 20 -o "$out.part" "$u" && { mv "$out.part" "$out"; return 0; }
      # 5xx/таймауты иногда только по IPv6 — пробуем IPv4
      warn "не вышло — пробую через IPv4"
      curl -4 -fL $bar --retry 2 --retry-delay 3 --connect-timeout 20 -o "$out.part" "$u" && { mv "$out.part" "$out"; return 0; }
    fi
    if command -v wget >/dev/null; then
      wget -q --show-progress -O "$out.part" "$u" && { mv "$out.part" "$out"; return 0; }
    fi
    rm -f "$out.part"
  done < <(alt_urls "$url")
  die "не скачалось: $url"
}

fetch_pkg() { # скачать и проверить все source пакета
  local p=$1 i=0 s f url want got known
  mkdir -p "$SOURCES" "$(dirname "$SUMS")"; touch "$SUMS"
  local -a srcs sums
  mapfile -t srcs < <(meta "$p" source)
  mapfile -t sums < <(meta "$p" sha256)
  for s in "${srcs[@]}"; do
    [ -n "$s" ] || continue
    f=$(src_name "$s"); url=$(src_url "$s"); want=${sums[$i]:-}; i=$((i+1))
    if [ ! -s "$SOURCES/$f" ]; then info "скачиваю $f"; download "$url" "$SOURCES/$f"; fi
    [ "$want" = SKIP ] && continue
    got=$(sha256sum "$SOURCES/$f" | cut -d' ' -f1)
    if [ -n "$want" ]; then
      [ "$got" = "$want" ] || die "контрольная сумма $f не совпала!
    ожидалось $want
    получено  $got
    Удали файл ($SOURCES/$f) и скачай заново."
    else
      known=$(awk -v f="$f" '$2==f{print $1}' "$SUMS" | tail -n1)
      if [ -z "$known" ]; then
        echo "$got $f" >> "$SUMS"; info "$f: сумма запомнена (sha256 ${got:0:16}…)"
      elif [ "$known" != "$got" ]; then
        die "$f изменился с прошлого раза (sha256 не тот). Если так и надо — убери его строку из $SUMS"
      fi
    fi
  done
}

# ---------- сборка ----------
run_step() { # run_step <пакет> <функция> <лог>
  local p=$1 fn=$2 log=$3 pid rc t0 line
  echo "=== $fn ===" >> "$log"
  (
    set -e -o pipefail
    export LC_ALL=C
    . "$(recipe_file "$p")"
    declare -F "$fn" >/dev/null || exit 0
    cd "$SRCDIR"
    "$fn"
  ) >> "$log" 2>&1 < /dev/null &
  pid=$!; t0=$SECONDS
  if [ -t 1 ]; then
    while kill -0 "$pid" 2>/dev/null; do
      line=$(tail -n 1 "$log" 2>/dev/null | tr -d '\r' | cut -c1-$(( ${COLUMNS:-80} - 22 )))
      printf '\r    %-8s [%4ds] %s\e[K' "$fn" $((SECONDS - t0)) "$line"
      sleep 1
    done
    printf '\r\e[K'
  fi
  wait "$pid"; rc=$?
  if [ "$rc" -ne 0 ]; then
    echo; tail -n 25 "$log"
    history_add "FAIL $p ($fn)"
    die "$p: шаг '$fn' упал (код $rc). Полный лог: creeper log $p"
  fi
  info "$fn: готово за $((SECONDS - t0)) с"
}

strip_tree() {
  local f
  find "$PKG" -type f \( -perm -u+x -o -name '*.so' -o -name '*.so.*' \) -print0 2>/dev/null |
  while IFS= read -r -d '' f; do
    case $(file -b "$f" 2>/dev/null) in
      *ELF*executable*|*ELF*shared\ object*|*ELF*pie\ executable*) strip --strip-unneeded "$f" 2>/dev/null ;;
    esac
  done
}

check_space() {
  mkdir -p "$WORK"
  local free; free=$(df -Pm "$WORK" 2>/dev/null | awk 'NR==2{print $4}')
  [ -n "$free" ] && [ "$free" -lt "$CREEPER_MINFREE_MB" ] && \
    warn "свободно всего ${free} МБ в $WORK — большой пакет может не поместиться (creeper clean --all)"
  return 0
}

owners_index() { # "пакет<TAB>путь" для всех установленных (кроме $1)
  local d n
  for d in "$DB"/*/; do
    [ -f "$d/files" ] || continue
    n=$(basename "$d"); [ "$n" = "$1" ] && continue
    awk -v n="$n" '{print n "\t" $0}' "$d/files"
  done
}

build_pkg() {
  local p=$1 ver rel t0=$SECONDS log
  ver=$(meta "$p" version); [ -n "$ver" ] || die "$p: в рецепте нет version"
  rel=$(pkgrel "$p")
  say "${CB}Ссссс...${CN} собираю $CB$p-$ver$CN"
  check_space
  fetch_pkg "$p"

  mkdir -p "$LOGS"; log=$LOGS/$p.log; : > "$log"
  local w=$WORK/$p
  rm -rf "$w"; mkdir -p "$w/src" "$w/pkg"
  export PKG=$w/pkg SOURCES name=$p version=$ver

  local s f
  while read -r s; do
    [ -n "$s" ] || continue
    f=$(src_name "$s")
    case $f in
      *.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2|*.tar.zst|*.tar.lz)
        tar -xf "$SOURCES/$f" -C "$w/src" || die "не распаковался $f" ;;
    esac
  done < <(meta "$p" source)

  local dirs; mapfile -t dirs < <(find "$w/src" -mindepth 1 -maxdepth 1 -type d)
  if [ "${#dirs[@]}" -eq 1 ]; then SRCDIR=${dirs[0]}; else SRCDIR=$w/src; fi
  export SRCDIR

  run_step "$p" prepare "$log"
  run_step "$p" build "$log"
  [ "$CREEPER_CHECK" = 1 ] && run_step "$p" check "$log"
  run_step "$p" package "$log"

  rm -f "$PKG/usr/share/info/dir"
  [ "$(meta "$p" keep_la)" = 1 ] || find "$PKG" -name '*.la' -delete 2>/dev/null   # .la не нужны (keep_la=1 — оставить)
  [ "$CREEPER_STRIP" = 1 ] && strip_tree
  [ -n "$(find "$PKG" -mindepth 1 -print -quit)" ] || die "$p: package() ничего не установил"

  mkdir -p "$PKG/.CREEPER"
  cp "$(recipe_file "$p")" "$PKG/.CREEPER/recipe"
  printf 'name=%s\nversion=%s\nrelease=%s\nbuilt=%s\n' "$p" "$ver" "$rel" "$(date '+%F %R')" > "$PKG/.CREEPER/info"
  if [ "$CREEPER_KEEPBIN" = 1 ]; then
    mkdir -p "$BINCACHE"
    local bf; bf=$BINCACHE/$(binfile "$p" "$ver" "$rel")
    if tar --zstd -C "$PKG" -cpf "$bf.part" . 2>>"$log"; then mv "$bf.part" "$bf"; info "бинарник сохранён: ${bf##*/}"
    else rm -f "$bf.part"; warn "$p: бинарник не сохранился (нет zstd?)"; fi
  fi

  install_tree "$p" "$ver"
  history_add "install $p-$ver-$rel (сборка, $((SECONDS - t0)) с)"
  say "$CB$p-$ver$CN установлен за $((SECONDS - t0)) с"
  rm -rf "$w"
}

# ---------- бинарные пакеты ----------
INDEX=
load_index() { # index.txt из BINREPO — один раз за запуск
  [ -n "$BINREPO" ] || return 1
  [ -n "$INDEX" ] && return 0
  mkdir -p "$WORK"; INDEX=$WORK/index.txt
  if { command -v curl >/dev/null && { curl -fsSL --retry 2 --connect-timeout 15 -o "$INDEX.part" "$BINREPO/index.txt" \
         || curl -4 -fsSL --retry 2 --connect-timeout 15 -o "$INDEX.part" "$BINREPO/index.txt"; }; } \
     || { command -v wget >/dev/null && wget -q -O "$INDEX.part" "$BINREPO/index.txt"; }; then
    mv "$INDEX.part" "$INDEX"
  elif [ -s "$INDEX" ]; then
    rm -f "$INDEX.part"; warn "репозиторий недоступен — беру прошлый список бинарников"
  else
    rm -f "$INDEX.part"; INDEX=/dev/null; warn "репозиторий бинарников недоступен ($BINREPO)"
  fi
  return 0
}

# строка индекса: имя версия релиз sha256 файл
bin_entry() { [ -n "$INDEX" ] || return 1; awk -v n="$1" -v v="$2" -v r="$3" '$1==n && $2==v && $3==r' "$INDEX" | tail -n1; }

plan_method() { # local | remote | source
  local p=$1 ver rel; ver=$(meta "$p" version); rel=$(pkgrel "$p")
  [ -n "${SOURCE_ONLY:-}" ] && { echo source; return; }
  [ -n "${REBUILD:-}" ] && [ -n "${TARGET[$p]:-}" ] && { echo source; return; }
  [ -s "$BINCACHE/$(binfile "$p" "$ver" "$rel")" ] && { echo local; return; }
  [ -n "$(bin_entry "$p" "$ver" "$rel")" ] && { echo remote; return; }
  echo source
}

fetch_bin() {
  local p=$1 ver rel e f sum got; ver=$(meta "$p" version); rel=$(pkgrel "$p")
  e=$(bin_entry "$p" "$ver" "$rel"); [ -n "$e" ] || die "$p: нет в репозитории"
  sum=$(echo "$e" | awk '{print $4}'); f=$(echo "$e" | awk '{print $5}')
  mkdir -p "$BINCACHE"
  if [ ! -s "$BINCACHE/$f" ]; then info "скачиваю $f"; download "$BINREPO/$f" "$BINCACHE/$f"; fi
  got=$(sha256sum "$BINCACHE/$f" | cut -d' ' -f1)
  [ "$got" = "$sum" ] || { rm -f "$BINCACHE/$f"; die "$f: контрольная сумма не совпала — файл удалён, попробуй ещё раз"; }
}

install_bin() {
  local p=$1 ver rel f t0=$SECONDS how=$2; ver=$(meta "$p" version); rel=$(pkgrel "$p")
  f=$BINCACHE/$(binfile "$p" "$ver" "$rel")
  say "${CB}Ссссс...${CN} ставлю готовый $CB$p-$ver$CN"
  local w=$WORK/$p; rm -rf "$w"; mkdir -p "$w/pkg"
  export PKG=$w/pkg
  tar --zstd -C "$PKG" -xpf "$f" || { rm -rf "$w"; die "$p: бинарник повреждён ($f) — удали его и повтори"; }
  [ -f "$PKG/.CREEPER/info" ] || { rm -rf "$w"; die "$p: это не пакет creeper ($f)"; }
  install_tree "$p" "$ver"
  history_add "install $p-$ver-$rel ($how)"
  say "$CB$p-$ver$CN установлен за $((SECONDS - t0)) с (бинарник)"
  rm -rf "$w"
}

install_tree() { # из $PKG в систему
  local p=$1 ver=$2 tmp=$WORK/.$p.lists b f
  rm -rf "$tmp"; mkdir -p "$tmp"
  local RCP=$tmp/recipe
  if [ -d "$PKG/.CREEPER" ]; then
    mv "$PKG/.CREEPER/recipe" "$RCP"; rm -rf "$PKG/.CREEPER"
  else
    cp "$(recipe_file "$p")" "$RCP"
  fi
  local -a bk=(); mapfile -t bk < <(meta_f "$RCP" backup | sed 's#^/*##')

  # конфиги: если уже есть и отличаются — не затираем
  for b in "${bk[@]}"; do
    [ -n "$b" ] || continue
    if [ -e "$PKG/$b" ] && [ -e "$ROOT/$b" ] && ! cmp -s "$PKG/$b" "$ROOT/$b"; then
      mv "$PKG/$b" "$PKG/$b.creeper-new"
      warn "конфиг /$b оставлен как был, новый — /$b.creeper-new"
    fi
  done

  { ( cd "$PKG" && find . -mindepth 1 \( -type f -o -type l \) -printf '/%P\n' )
    for b in "${bk[@]}"; do [ -n "$b" ] && [ -e "$ROOT/$b" ] && echo "/$b"; done
  } | normalize | sort -u > "$tmp/files"
  ( cd "$PKG" && find . -mindepth 1 -type d -printf '/%P\n' ) | normalize | sort -u > "$tmp/dirs"
  # контрольные суммы файлов (кроме конфигов) — для creeper verify
  ( cd "$PKG" && find . -type f ! -name '*.creeper-new' -printf '%P\0' | xargs -0 -r sha256sum ) |
    awk '{print substr($0,1,64) "  /" substr($0,67)}' |
    sed -e 's#  /bin/#  /usr/bin/#' -e 's#  /sbin/#  /usr/sbin/#' -e 's#  /lib/#  /usr/lib/#' > "$tmp/sha256"
  if [ ${#bk[@]} -gt 0 ]; then
    local bpat; bpat=$(printf '/%s\n' "${bk[@]}")
    grep -vF -e "$bpat" "$tmp/sha256" > "$tmp/sha256.f" || true; mv "$tmp/sha256.f" "$tmp/sha256"
  fi

  # конфликты с другими пакетами
  local conf
  conf=$(awk -F'\t' 'FILENAME==ARGV[1]{own[$2]=$1; next} ($0 in own){print "    " $0 "  (пакет " own[$0] ")"}' <(owners_index "$p") "$tmp/files")
  if [ -n "$conf" ]; then
    echo "$conf" | head -n 20 >&2
    [ -n "${FORCE:-}" ] || { rm -rf "$tmp"; die "$p: файлы уже принадлежат другим пакетам (добавь --force, если уверен)"; }
  fi

  # копирование; --keep-directory-symlink бережёт ссылки /lib -> usr/lib и т.п.
  tar -C "$PKG" -cpf - . | tar -C "$ROOT/" -xpf - --keep-directory-symlink --no-overwrite-dir \
    || die "$p: ошибка копирования в систему (часть файлов могла встать — повтори установку)"

  # обновление: убрать файлы, которых в новой версии нет
  if [ -f "$DB/$p/files" ]; then
    local keep; keep=$(printf '/%s\n' "${bk[@]}")
    comm -23 "$DB/$p/files" "$tmp/files" | { if [ ${#bk[@]} -gt 0 ]; then grep -vxF -e "$keep"; else cat; fi; } |
      while IFS= read -r f; do rm -f "$ROOT$f"; done
    [ -f "$DB/$p/dirs" ] && comm -23 "$DB/$p/dirs" "$tmp/dirs" | sort -r |
      while IFS= read -r f; do protected_dir "$f" || rmdir "$ROOT$f" 2>/dev/null; done
  fi

  # кто просил: явно (explicit) или как зависимость (dep); явное не понижаем
  local reason=dep
  if [ -n "${TARGET[$p]:-}" ]; then reason=explicit
  elif installed "$p"; then reason=$(cat "$DB/$p/reason" 2>/dev/null || echo explicit); fi

  mkdir -p "$DB/$p"
  mv "$tmp/files" "$DB/$p/files"; mv "$tmp/dirs" "$DB/$p/dirs"; mv "$tmp/sha256" "$DB/$p/sha256"
  echo "$ver" > "$DB/$p/version"
  local rel; rel=$(meta_f "$RCP" release); echo "${rel:-1}" > "$DB/$p/release"
  meta_f "$RCP" depends > "$DB/$p/depends"
  printf '%s\n' "${bk[@]}" | sed '/^$/d' > "$DB/$p/backup"
  echo "$reason" > "$DB/$p/reason"
  date '+%F %R' > "$DB/$p/date"
  cp "$RCP" "$DB/$p/recipe"
  rm -rf "$tmp"
  sync                                   # сразу на диск — зависание не оставит пустых файлов
  [ -z "$ROOT" ] && command -v ldconfig >/dev/null && ldconfig

  if [ -z "$ROOT" ]; then
    ( set -e; . "$DB/$p/recipe"; declare -F post_install >/dev/null || exit 0; cd /; post_install )
    [ $? -eq 0 ] || warn "$p: post_install завершился с ошибкой"
  fi
}

# ---------- удаление ----------
rdeps() { # кто из установленных зависит от $1
  local d
  for d in "$DB"/*/; do
    [ -f "$d/depends" ] || continue
    grep -qx -- "$1" "$d/depends" && basename "$d"
  done
}

protected_dir() { # / и каталоги первых двух уровней (/usr/lib, /etc/ssl…) не трогаем
  local s=${1//[^\/]/}
  [ ${#s} -le 2 ]
}

blow_pkg() {
  local p=$1 f b n=0
  say "${CB}Сссссс...${CN} $p-$(inst_version "$p")"
  local -A keep=()
  if [ -z "${PURGE:-}" ]; then
    while IFS= read -r b; do [ -n "$b" ] && keep[/${b#/}]=1; done < "$DB/$p/backup"
  fi
  if [ -z "$ROOT" ]; then
    ( . "$DB/$p/recipe"; declare -F pre_blow >/dev/null || exit 0; cd /; pre_blow ) || true
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -n "${keep[$f]:-}" ]; then info "конфиг $f сохранён"; continue; fi
    rm -f "$ROOT$f" && n=$((n+1))
  done < "$DB/$p/files"
  sort -r "$DB/$p/dirs" | while IFS= read -r f; do
    protected_dir "$f" && continue
    rmdir "$ROOT$f" 2>/dev/null
  done
  history_add "blow $p-$(inst_version "$p")"
  rm -rf "${DB:?}/$p"
  sync
  [ -z "$ROOT" ] && command -v ldconfig >/dev/null && ldconfig
  printf '%s    *** БА-БАХ! ***%s  %s взорван (%d файлов)\n' "$CR" "$CN" "$p" "$n"
}

blow_set() { # blow_set <пакеты...> — порядок: сначала те, от кого никто не зависит
  local -a want=("$@") order=(); local -A inset=() fin=(); local a d left progress
  for a in "${want[@]}"; do installed "$a" || die "'$a' не установлен"; inset[$a]=1; done
  if [ -z "${FORCE:-}" ]; then
    for a in "${want[@]}"; do
      left=
      for d in $(rdeps "$a"); do [ -z "${inset[$d]:-}" ] && left+="$d "; done
      [ -z "$left" ] || die "от '$a' зависят: $left— взорви их вместе с ним или добавь --force"
    done
  fi
  while [ ${#order[@]} -lt ${#want[@]} ]; do
    progress=
    for a in "${want[@]}"; do
      [ -n "${fin[$a]:-}" ] && continue
      left=
      for d in $(rdeps "$a"); do [ -n "${inset[$d]:-}" ] && [ -z "${fin[$d]:-}" ] && left=1; done
      if [ -z "$left" ] || [ -n "${FORCE:-}" ]; then order+=("$a"); fin[$a]=1; progress=1; fi
    done
    [ -n "$progress" ] || die "не могу определить порядок удаления (взаимные зависимости?) — используй --force"
  done
  if [ -t 0 ] && [ -z "${YES:-}" ]; then
    printf '%s будет взорвано:%s %s\nПродолжить? [y/N] ' "$CR" "$CN" "${order[*]}"
    read -r a; case $a in y|Y|yes|д|Д|да) ;; *) die "отменено";; esac
  fi
  for a in "${order[@]}"; do blow_pkg "$a"; done
}

# ---------- команды ----------
run_plan() { # скачать всё, потом установить
  local a m line=
  [ -z "${SOURCE_ONLY:-}" ] && load_index
  for a in "$@"; do m=$(plan_method "$a"); METHOD[$a]=$m
    case $m in local) line+=" $a${CG}[кэш]${CN}";; remote) line+=" $a${CG}[скачать]${CN}";; *) line+=" $a${CY}[сборка]${CN}";; esac
  done
  say "будет установлено:$line"
  for a in "$@"; do case ${METHOD[$a]} in remote) fetch_bin "$a";; source) fetch_pkg "$a";; esac; done
  [ -n "${FETCH_ONLY:-}" ] && { say "всё скачано — можно отключать сеть"; return 0; }
  for a in "$@"; do case ${METHOD[$a]} in
    local) install_bin "$a" "бинарник из кэша";;
    remote) install_bin "$a" "бинарник из репозитория";;
    *) build_pkg "$a";; esac; done
}

cmd_install() {
  local -a want=(); local a
  for a in "$@"; do case $a in
    --rebuild) REBUILD=1;; --reinstall) REINSTALL=1;; --source|-s) SOURCE_ONLY=1;; --check) CREEPER_CHECK=1;; --force) FORCE=1;;
    -*) die "неизвестный ключ $a";; *) want+=("$a");; esac; done
  [ ${#want[@]} -gt 0 ] || die "что ставить? пример: sudo creeper install git"
  need_root install; lock
  for a in "${want[@]}"; do
    have_recipe "$a" || die "нет рецепта '$a' (поиск: creeper search $a; обновить рецепты: sudo creeper sync)"
    TARGET[$a]=1
    if installed "$a" && [ -z "${REBUILD:-}${REINSTALL:-}" ] && [ "$(inst_version "$a")" = "$(meta "$a" version)" ] \
       && [ "$(inst_release "$a")" = "$(pkgrel "$a")" ]; then
      [ "$(cat "$DB/$a/reason" 2>/dev/null)" = explicit ] || echo explicit > "$DB/$a/reason"
      info "$a-$(inst_version "$a") уже установлен (переставить: --reinstall, пересобрать: --rebuild)"; continue
    fi
    resolve "$a"
  done
  [ ${#RESOLVED[@]} -gt 0 ] || return 0
  run_plan "${RESOLVED[@]}"
}

cmd_blow() {
  local -a want=(); local a
  for a in "$@"; do case $a in
    --force) FORCE=1;; --purge) PURGE=1;; -y|--yes) YES=1;;
    -*) die "неизвестный ключ $a";; *) want+=("$a");; esac; done
  [ ${#want[@]} -gt 0 ] || die "что взрывать? пример: sudo creeper blow wget"
  need_root blow; lock
  blow_set "${want[@]}"
}

orphans() { # зависимости (reason=dep), которые никому не нужны — повторяем, пока находятся
  local -A gone=(); local d p r found=1 needed
  while [ -n "$found" ]; do
    found=
    for d in "$DB"/*/; do
      p=$(basename "$d"); [ -f "$d/version" ] || continue
      [ -n "${gone[$p]:-}" ] && continue
      [ "$(cat "$d/reason" 2>/dev/null)" = dep ] || continue
      needed=
      for r in $(rdeps "$p"); do [ -z "${gone[$r]:-}" ] && needed=1; done
      [ -z "$needed" ] && { gone[$p]=1; found=1; }
    done
  done
  for p in "${!gone[@]}"; do echo "$p"; done | sort
}

cmd_orphans() { local o; o=$(orphans); [ -n "$o" ] && echo "$o" || info "ненужных зависимостей нет"; }

cmd_autoremove() {
  local a; for a in "$@"; do case $a in -y|--yes) YES=1;; esac; done
  need_root autoremove; lock
  local -a o; mapfile -t o < <(orphans)
  [ ${#o[@]} -gt 0 ] || { info "ненужных зависимостей нет"; return 0; }
  blow_set "${o[@]}"
}

cmd_fetch() {
  local -a want=(); local a
  for a in "$@"; do case $a in --source|-s) SOURCE_ONLY=1;; -*) die "неизвестный ключ $a";; *) want+=("$a");; esac; done
  [ ${#want[@]} -gt 0 ] || die "что скачать?"
  need_root fetch; lock
  for a in "${want[@]}"; do TARGET[$a]=1; resolve "$a"; done
  FETCH_ONLY=1 run_plan "${RESOLVED[@]}"
}

cmd_upgrade() {
  need_root upgrade; lock
  local d p
  for d in "$DB"/*/; do
    p=$(basename "$d"); [ -f "$d/version" ] || continue
    have_recipe "$p" || continue
    if [ "$(inst_version "$p")" != "$(meta "$p" version)" ] || [ "$(inst_release "$p")" != "$(pkgrel "$p")" ]; then
      info "$p: $(inst_version "$p")-$(inst_release "$p") → $(meta "$p" version)-$(pkgrel "$p")"
      resolve "$p"
    fi
  done
  [ ${#RESOLVED[@]} -gt 0 ] || { say "всё свежее"; return 0; }
  run_plan "${RESOLVED[@]}"
}

cmd_pack() {
  need_root pack
  local p=${1:?укажи пакет} ver rel t out
  installed "$p" || die "'$p' не установлен"
  ver=$(inst_version "$p"); rel=$(inst_release "$p")
  t=$(mktemp -d); mkdir -p "$t/.CREEPER" "$BINCACHE"
  cp "$DB/$p/recipe" "$t/.CREEPER/recipe"
  printf 'name=%s\nversion=%s\nrelease=%s\nbuilt=%s\n' "$p" "$ver" "$rel" "$(cat "$DB/$p/date")" > "$t/.CREEPER/info"
  sed 's#^/##' "$DB/$p/files" | grep -v '\.creeper-new$' > "$t/list"
  out=$BINCACHE/$(binfile "$p" "$ver" "$rel")
  tar --zstd -cpf "$out.part" -C "$t" .CREEPER -C "$ROOT/" --no-recursion -T "$t/list" \
    || { rm -rf "$t" "$out.part"; die "не упаковалось (пропали файлы? проверь: creeper verify $p)"; }
  mv "$out.part" "$out"; rm -rf "$t"
  say "готово: $out ($(du -h "$out" | cut -f1))"
}

cmd_index() {
  local f n v r inf
  for f in "$BINCACHE"/*.tar.zst; do
    [ -f "$f" ] || continue
    inf=$(tar --zstd -xOf "$f" --wildcards '*.CREEPER/info' 2>/dev/null) || continue
    n=$(echo "$inf" | sed -n 's/^name=//p'); v=$(echo "$inf" | sed -n 's/^version=//p'); r=$(echo "$inf" | sed -n 's/^release=//p')
    [ -n "$n" ] && [ -n "$v" ] || continue
    printf '%s %s %s %s %s\n' "$n" "$v" "${r:-1}" "$(sha256sum "$f" | cut -d' ' -f1)" "$(basename "$f")"
  done | sort
}

cmd_sync() {
  need_root sync; lock
  [ -n "$BINREPO" ] || die "BINREPO не задан в $CONF"
  local t; t=$(mktemp -d)
  download "$BINREPO/recipes.tar.gz" "$t/r.tar.gz"
  tar -xzf "$t/r.tar.gz" -C "$t" || { rm -rf "$t"; die "архив рецептов повреждён"; }
  [ -d "$t/recipes" ] || { rm -rf "$t"; die "в архиве нет папки recipes/"; }
  local r n new=0 changed=0
  mkdir -p "$RECIPES"
  for r in "$t"/recipes/*/; do
    n=$(basename "$r")
    if [ ! -f "$RECIPES/$n/recipe" ]; then new=$((new+1))
    elif ! cmp -s "$r/recipe" "$RECIPES/$n/recipe"; then changed=$((changed+1)); fi
  done
  cp -r "$t"/recipes/* "$RECIPES/"
  say "рецепты: всего $(ls "$t/recipes" | wc -l), новых $new, изменённых $changed"
  rm -rf "$t"
  load_index && [ -s "$INDEX" ] && info "бинарников в репозитории: $(wc -l < "$INDEX")"
  # есть ли новый creeper?
  local v; v=$(curl -fsSL --connect-timeout 10 "$BINREPO/creeper.version" 2>/dev/null | awk '{print $1}')
  [ -n "$v" ] && [ "$v" != "$CREEPER_VERSION" ] && info "доступен creeper $v (у тебя $CREEPER_VERSION): sudo creeper self-update"
  local o; o=$(cmd_upgrade_list); [ -n "$o" ] && info "можно обновить: $o (sudo creeper upgrade)"
  return 0
}

cmd_upgrade_list() {
  local d p out=
  for d in "$DB"/*/; do
    p=$(basename "$d"); [ -f "$d/version" ] && have_recipe "$p" || continue
    if [ "$(inst_version "$p")" != "$(meta "$p" version)" ] || [ "$(inst_release "$p")" != "$(pkgrel "$p")" ]; then out+="$p "; fi
  done
  echo "$out"
}

cmd_self_update() {
  need_root self-update; lock
  [ -n "$BINREPO" ] || die "BINREPO не задан в $CONF"
  local t v sum got me; t=$(mktemp -d)
  download "$BINREPO/creeper.version" "$t/ver"
  read -r v sum < "$t/ver"
  [ -n "$v" ] && [ -n "$sum" ] || { rm -rf "$t"; die "creeper.version в репозитории странный"; }
  if [ "$v" = "$CREEPER_VERSION" ] && [ "$(sha256sum "$0" | cut -d' ' -f1)" = "$sum" ]; then
    rm -rf "$t"; say "у тебя последний creeper ($v)"; return 0
  fi
  download "$BINREPO/creeper" "$t/creeper"
  got=$(sha256sum "$t/creeper" | cut -d' ' -f1)
  [ "$got" = "$sum" ] || { rm -rf "$t"; die "контрольная сумма нового creeper не совпала — не обновляю"; }
  bash -n "$t/creeper" || { rm -rf "$t"; die "новый creeper не проходит проверку синтаксиса — не обновляю"; }
  me=$(readlink -f "$0")
  install -m755 "$t/creeper" "$me.new" && mv "$me.new" "$me"
  rm -rf "$t"
  history_add "self-update $CREEPER_VERSION -> $v"
  say "creeper обновлён: $CREEPER_VERSION → $v"
}

cmd_verify() {
  need_root verify
  local -a pk=("$@"); local p d bad=0 total=0 out
  if [ ${#pk[@]} -eq 0 ]; then for d in "$DB"/*/; do [ -f "$d/version" ] && pk+=("$(basename "$d")"); done; fi
  [ ${#pk[@]} -gt 0 ] || { info "нечего проверять"; return 0; }
  for p in "${pk[@]}"; do
    installed "$p" || { warn "'$p' не установлен"; continue; }
    total=$((total+1))
    if [ -s "$DB/$p/sha256" ]; then
      out=$(sed "s#  /#  $ROOT/#" "$DB/$p/sha256" | LC_ALL=C sha256sum -c --quiet 2>&1 | grep -v '^sha256sum:' | sed "s#$ROOT/#/#")
    else
      out=$(while IFS= read -r f; do [ -e "$ROOT$f" ] || [ -L "$ROOT$f" ] || echo "$f: пропал"; done < "$DB/$p/files")
    fi
    if [ -n "$out" ]; then
      bad=$((bad+1)); printf '%s%s%s:\n' "$CR" "$p" "$CN"; echo "$out" | head -n 15 | sed 's/^/    /'
    fi
  done
  if [ $bad -eq 0 ]; then say "проверено пакетов: $total — всё цело"
  else warn "повреждено пакетов: $bad из $total. Починить: sudo creeper install --reinstall <пакет>"; return 1; fi
}

cmd_deps() {
  local p=${1:?укажи пакет}
  have_recipe "$p" || die "нет рецепта '$p'"
  local -A shown=()
  deps_tree() {
    local q=$1 pre=$2 mark d
    if installed "$q"; then mark="${CG}✓${CN}"; else mark="${CY}·${CN}"; fi
    echo "$pre$mark $q $(meta "$q" version 2>/dev/null)"
    [ -n "${shown[$q]:-}" ] && return; shown[$q]=1
    have_recipe "$q" || return
    for d in $(meta "$q" depends); do deps_tree "$d" "$pre    "; done
  }
  deps_tree "$p" ""
  info "✓ установлен   · будет поставлен"
}

cmd_clean() {
  need_root clean; lock
  local before after
  before=$(du -sm "$WORK" "$SOURCES" "$BINCACHE" 2>/dev/null | awk '{s+=$1} END{print s+0}')
  rm -rf "${WORK:?}"/* "$WORK"/.[!.]* 2>/dev/null
  find "$SOURCES" "$BINCACHE" -name '*.part' -delete 2>/dev/null
  if [ "${1:-}" = --all ]; then
    # исходники и бинарники, не относящиеся к установленным версиям
    local f keep d p v r
    declare -A keepf=()
    for d in "$DB"/*/; do
      p=$(basename "$d"); [ -f "$d/version" ] || continue
      v=$(inst_version "$p"); r=$(inst_release "$p")
      keepf[$(binfile "$p" "$v" "$r")]=1
      if [ -f "$d/recipe" ]; then
        while read -r s; do [ -n "$s" ] && keepf[$(src_name "$s")]=1; done < <(meta_f "$d/recipe" source)
      fi
    done
    for f in "$SOURCES"/* "$BINCACHE"/*; do
      [ -f "$f" ] || continue
      [ -n "${keepf[$(basename "$f")]:-}" ] || rm -f "$f"
    done
  fi
  after=$(du -sm "$WORK" "$SOURCES" "$BINCACHE" 2>/dev/null | awk '{s+=$1} END{print s+0}')
  say "освобождено $((before - after)) МБ"
}

cmd_log() {
  local p=${1:?укажи пакет}
  [ -f "$LOGS/$p.log" ] || die "лога для '$p' нет"
  if [ -t 1 ] && command -v less >/dev/null; then less +G "$LOGS/$p.log"; else tail -n 100 "$LOGS/$p.log"; fi
}

cmd_history() { [ -f "$HISTORY" ] && tail -n "${1:-40}" "$HISTORY" || info "история пуста"; }

cmd_new() {
  local url=${1:?укажи ссылку на архив исходников} f base n v dir out
  f=$(basename "${url%%\?*}")
  base=${f%.tar.*}; base=${base%.tgz}; base=${base%.tar}
  n=$(echo "$base" | sed -E 's/[-_]v?[0-9][0-9a-zA-Z.]*$//' | tr 'A-Z' 'a-z')
  v=$(echo "$base" | sed -E 's/^.*[-_]v?([0-9][0-9a-zA-Z.]*)$/\1/')
  [ -n "$n" ] && [ "$v" != "$base" ] || die "не понял имя/версию из '$f' — назови файл по образцу name-1.2.3.tar.xz"
  dir=${RECIPES_OUT:-.}/$n; out=$dir/recipe
  [ -e "$out" ] && die "$out уже есть"
  mkdir -p "$dir"
  local u=${url//$v/\$version}
  cat > "$out" <<EOF
name=$n
version=$v
desc="ОПИСАНИЕ"
url=
source=($u)
depends=()
# backup=(etc/$n.conf)      # конфиги, которые не надо затирать при обновлении

# --- autotools (./configure) ---
build() {
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make
}
package() { make DESTDIR="\$PKG" install; }

# --- meson (раскомментируй и убери блок выше) ---
#build()   { meson setup build --prefix=/usr --buildtype=release; ninja -C build -j"\$JOBS"; }
#package() { DESTDIR="\$PKG" ninja -C build install; }

# --- cmake ---
#build()   { cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -G Ninja; ninja -C build -j"\$JOBS"; }
#package() { DESTDIR="\$PKG" ninja -C build install; }
EOF
  say "заготовка: $out"
  info "проверь desc, depends и способ сборки; положи в recipes/ репозитория и запусти ферму"
}


# ---------- ферма: GitHub API ----------
GH_HDR=; GH_OUT=; GH_CODE=; REPO_SHA=
farm_cleanup() { [ -n "$GH_HDR" ] && rm -f "$GH_HDR"; [ -n "$GH_OUT" ] && rm -f "$GH_OUT"; return 0; }
farm_init() {
  [ -n "$FARM_REPO" ] || die "не знаю репозиторий фермы: задай BINREPO (или FARM_REPO=владелец/репо) в $CONF"
  command -v curl >/dev/null || die "нужен curl"
  command -v python3 >/dev/null || die "нужен python3"
  local tok=${CREEPER_GITHUB_TOKEN:-}
  [ -z "$tok" ] && [ -r "$FARM_TOKEN_FILE" ] && tok=$(tr -d ' \n\r' < "$FARM_TOKEN_FILE")
  [ -n "$tok" ] || die "нет токена GitHub. Создай и сохрани: sudo creeper farm token"
  GH_HDR=$(umask 077; mktemp); GH_OUT=$(umask 077; mktemp)
  trap farm_cleanup EXIT
  printf 'Authorization: Bearer %s\n' "$tok" > "$GH_HDR"   # токен не попадает в список процессов
}
# gh_api МЕТОД /путь [json] — ответ в $GH_OUT, код в $GH_CODE; 0 при 2xx. Вызывать НЕ в $(...)
gh_api() {
  local m=$1 path=$2 data=${3:-}
  local -a a=(-sS -X "$m" -H @"$GH_HDR" -H "Accept: application/vnd.github+json"
              -H "X-GitHub-Api-Version: 2022-11-28" -o "$GH_OUT" -w '%{http_code}' --connect-timeout 20)
  [ -n "$data" ] && a+=(-H "Content-Type: application/json" --data-binary @-)
  GH_CODE=$(printf '%s' "$data" | curl "${a[@]}" "$FARM_API$path" 2>/dev/null) \
    || GH_CODE=$(printf '%s' "$data" | curl -4 "${a[@]}" "$FARM_API$path" 2>/dev/null) || GH_CODE=000
  case $GH_CODE in 2??) return 0;; *) return 1;; esac
}
# gh_py 'код' — разобрать последний ответ API (d — данные)
gh_py() { python3 -c "import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
$1" "$GH_OUT"; }
gh_fail() {
  local msg; msg=$(gh_py 'print(d.get("message","") if isinstance(d,dict) else "")' 2>/dev/null)
  case $GH_CODE in
    000) die "$1: нет связи с api.github.com" ;;
    401) die "$1: токен не принят (истёк или опечатка) — sudo creeper farm token" ;;
    403|404) die "$1: доступ запрещён (HTTP $GH_CODE: ${msg:-?}). Проверь токен: репозиторий $FARM_REPO, права Actions и Contents — Read and write" ;;
    *) die "$1: HTTP $GH_CODE ${msg:-}" ;;
  esac
}

blob_sha() { python3 -c "import hashlib,sys
b=open(sys.argv[1],'rb').read(); print(hashlib.sha1(b'blob %d\0' % len(b) + b).hexdigest())" "$1"; }

repo_recipe_sha() { # sha рецепта в репозитории → $REPO_SHA (пусто, если нет)
  REPO_SHA=
  if gh_api GET "/repos/$FARM_REPO/contents/recipes/$1/recipe?ref=$FARM_REF"; then
    REPO_SHA=$(gh_py 'print(d.get("sha",""))'); return 0
  fi
  [ "$GH_CODE" = 404 ] && return 0
  gh_fail "проверка рецепта $1"
}

farm_send_file() {
  local f=$1 n v body
  bash -n "$f" || die "$f: ошибка в рецепте"
  n=$(meta_f "$f" name); v=$(meta_f "$f" version)
  [ -n "$n" ] && [ -n "$v" ] || die "$f: в рецепте нет name/version"
  [[ $n =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || die "$f: странное имя пакета '$n'"
  repo_recipe_sha "$n"
  body=$(python3 -c "import json,sys,base64
f,n,v,sha,ref=sys.argv[1:6]
d={'message':'рецепт %s-%s (из LFS)'%(n,v),'content':base64.b64encode(open(f,'rb').read()).decode(),'branch':ref}
if sha: d['sha']=sha
print(json.dumps(d))" "$f" "$n" "$v" "$REPO_SHA" "$FARM_REF")
  gh_api PUT "/repos/$FARM_REPO/contents/recipes/$n/recipe" "$body" || gh_fail "отправка рецепта $n"
  say "рецепт $n-$v отправлен в $FARM_REPO"
  if [ "$(readlink -f "$f")" != "$(readlink -f "$(recipe_file "$n")")" ]; then
    mkdir -p "$RECIPES/$n"; cp "$f" "$RECIPES/$n/recipe"
  fi
}

cmd_farm_token() {
  need_root "farm token"
  [ -n "$FARM_REPO" ] || die "не знаю репозиторий фермы: задай BINREPO в $CONF"
  echo "Нужен fine-grained токен GitHub (вход под владельцем репозитория):"
  echo "  github.com → Settings → Developer settings → Personal access tokens → Fine-grained tokens"
  echo "  Repository access: Only select repositories → $FARM_REPO"
  echo "  Permissions: Actions — Read and write, Contents — Read and write"
  local t; read -r -s -p "Вставь токен (не отображается): " t; echo
  t=$(printf '%s' "$t" | tr -d ' \r\n')
  [ -n "$t" ] || die "пусто"
  mkdir -p "$(dirname "$FARM_TOKEN_FILE")"; chmod 700 "$(dirname "$FARM_TOKEN_FILE")"
  ( umask 077; printf '%s\n' "$t" > "$FARM_TOKEN_FILE" ); chmod 600 "$FARM_TOKEN_FILE"
  unset t
  farm_init
  gh_api GET "/repos/$FARM_REPO" || gh_fail "проверка токена"
  local perm; perm=$(gh_py 'p=d.get("permissions",{}); print("запись есть" if p.get("push") else "только чтение (мало!)")')
  say "токен сохранён в $FARM_TOKEN_FILE (только для root); доступ к $FARM_REPO: $perm"
}

cmd_farm_send() {
  need_root "farm send"; [ $# -gt 0 ] || die "что отправить? пример: sudo creeper farm send htop  (или путь к файлу recipe)"
  farm_init
  local a f
  for a in "$@"; do
    if [ -f "$a" ]; then f=$a; elif [ -f "$a/recipe" ]; then f=$a/recipe; elif have_recipe "$a"; then f=$(recipe_file "$a")
    else die "не нашёл рецепт '$a'"; fi
    farm_send_file "$f"
  done
}

farm_last_run_id() { # → $RUN_ID (0, если запусков не было)
  gh_api GET "/repos/$FARM_REPO/actions/workflows/$FARM_WORKFLOW/runs?per_page=1" || gh_fail "список сборок"
  RUN_ID=$(gh_py 'r=d.get("workflow_runs",[]); print(r[0]["id"] if r else 0)')
}

farm_show_log() { # выдержка из лога упавшей задачи запуска $1
  local id=$1 job tmp
  gh_api GET "/repos/$FARM_REPO/actions/runs/$id/jobs" || { warn "лог недоступен"; return 0; }
  job=$(gh_py '
js=d.get("jobs",[])
bad=[j for j in js if j.get("conclusion") not in ("success","skipped",None)]
print((bad or js or [{"id":""}])[0]["id"])')
  [ -n "$job" ] || { warn "лог не найден"; return 0; }
  tmp=$(mktemp)
  curl -sSL -H @"$GH_HDR" -o "$tmp" "$FARM_API/repos/$FARM_REPO/actions/jobs/$job/logs" 2>/dev/null \
    || curl -4 -sSL -H @"$GH_HDR" -o "$tmp" "$FARM_API/repos/$FARM_REPO/actions/jobs/$job/logs" 2>/dev/null
  sed -E 's/^[0-9]{4}-[0-9-]+T[0-9:.]+Z ?//' "$tmp" | grep -E 'xx>|!!>|==>|##\[error\]|error:|Error ' | tail -n 30
  rm -f "$tmp"
}

cmd_farm_build() {
  local -a want=(); local a rebuild=false noinst=
  for a in "$@"; do case $a in
    --rebuild) rebuild=true;; --no-install) noinst=1;;
    -*) die "неизвестный ключ $a";; *) want+=("$a");; esac; done
  [ ${#want[@]} -gt 0 ] || die "что собрать? пример: sudo creeper farm build dwm"
  need_root "farm build"; farm_init
  for a in "${want[@]}"; do [[ $a =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || die "плохое имя пакета: $a"; done

  # рецепты (с зависимостями) должны быть в репозитории и совпадать с твоими
  local -A seen=(); local -a queue=("${want[@]}") todo=(); local p d lsha
  info "сверяю рецепты с репозиторием..."
  while [ ${#queue[@]} -gt 0 ]; do
    p=${queue[0]}; queue=("${queue[@]:1}")
    [ -n "${seen[$p]:-}" ] && continue; seen[$p]=1
    have_recipe "$p" || continue
    for d in $(meta "$p" depends); do queue+=("$d"); done
    lsha=$(blob_sha "$(recipe_file "$p")"); repo_recipe_sha "$p"
    if [ -z "$REPO_SHA" ]; then info "$p: рецепта нет в репозитории"; todo+=("$p")
    elif [ "$REPO_SHA" != "$lsha" ]; then info "$p: твой рецепт отличается от рецепта в репозитории"; todo+=("$p"); fi
  done
  if [ ${#todo[@]} -gt 0 ]; then
    local ans=y
    if [ -t 0 ]; then read -r -p "Отправить на ферму свои рецепты (${todo[*]})? [Y/n] " ans; fi
    case $ans in n|N|нет) warn "собираю по рецептам из репозитория";;
      *) for p in "${todo[@]}"; do farm_send_file "$(recipe_file "$p")"; done; sleep 3;; esac
  fi
  for a in "${want[@]}"; do
    have_recipe "$a" && continue
    repo_recipe_sha "$a"; [ -n "$REPO_SHA" ] || die "рецепта '$a' нет ни у тебя, ни в репозитории"
  done

  local prev id= body st concl url step t0=$SECONDS
  farm_last_run_id; prev=${RUN_ID:-0}
  body=$(python3 -c "import json,sys; print(json.dumps({'ref':sys.argv[1],'inputs':{'packages':sys.argv[2],'rebuild':sys.argv[3]}}))" \
         "$FARM_REF" "${want[*]}" "$rebuild")
  gh_api POST "/repos/$FARM_REPO/actions/workflows/$FARM_WORKFLOW/dispatches" "$body" || gh_fail "запуск фермы"
  say "ферма запущена: ${want[*]}"
  for _ in $(seq 1 30); do
    sleep "$(( FARM_POLL < 4 ? FARM_POLL : 4 ))"
    gh_api GET "/repos/$FARM_REPO/actions/workflows/$FARM_WORKFLOW/runs?per_page=5" || continue
    id=$(gh_py "
for r in d.get('workflow_runs',[]):
    if r['id']>$prev and r.get('event')=='workflow_dispatch': print(r['id']); break")
    [ -n "$id" ] && break
  done
  [ -n "$id" ] || die "запуск не появился на GitHub — посмотри: sudo creeper farm status"
  url="https://github.com/$FARM_REPO/actions/runs/$id"
  info "$url"
  info "можно прервать Ctrl+C — сборка продолжится на GitHub (потом: sudo creeper sync && sudo creeper install ...)"
  history_add "farm build ${want[*]} (запуск $id)"
  st=; concl=
  while :; do
    if gh_api GET "/repos/$FARM_REPO/actions/runs/$id"; then
      read -r st concl < <(gh_py 'print(d.get("status","?"), d.get("conclusion") or "-")')
      [ "$st" = completed ] && break
    fi
    step="ожидание сервера"
    gh_api GET "/repos/$FARM_REPO/actions/runs/$id/jobs" && step=$(gh_py '
s="ожидание сервера"
for j in d.get("jobs",[]):
    for x in j.get("steps",[]):
        if x.get("status")=="in_progress": s=x["name"]
print(s)')
    if [ -t 1 ]; then printf '\r    [%3d:%02d] %s\e[K' $(( (SECONDS-t0)/60 )) $(( (SECONDS-t0)%60 )) "$step"
    else info "[$(( (SECONDS-t0)/60 )) мин] $step"; fi
    sleep "$FARM_POLL"
  done
  [ -t 1 ] && printf '\r\e[K'
  if [ "$concl" = success ]; then
    say "ферма собрала за $(( (SECONDS-t0)/60 )) мин: ${want[*]}"
  else
    warn "сборка на ферме: $concl"
    farm_show_log "$id"
    info "весь лог: $url"
    history_add "farm FAIL ${want[*]} (запуск $id)"
  fi
  # всё, что успело собраться, уже выложено
  ( cmd_sync ) >/dev/null 2>&1 || warn "sync не удался — повтори: sudo creeper sync"
  if [ -z "$noinst" ]; then
    INDEX=; load_index
    local -a ok=()
    for a in "${want[@]}"; do
      have_recipe "$a" || continue
      if [ -n "$(bin_entry "$a" "$(meta "$a" version)" "$(pkgrel "$a")")" ]; then ok+=("$a"); else warn "$a: бинарника на ферме нет"; fi
    done
    [ ${#ok[@]} -gt 0 ] && cmd_install "${ok[@]}"
  fi
  [ "$concl" = success ]
}

cmd_farm_status() {
  farm_init
  gh_api GET "/repos/$FARM_REPO/actions/workflows/$FARM_WORKFLOW/runs?per_page=8" || gh_fail "статус фермы"
  gh_py '
for r in d.get("workflow_runs",[]):
    st=r.get("conclusion") or r.get("status")
    mark={"success":"ok ","failure":"ОШ ","cancelled":"отм","skipped":" - "}.get(st,"...")
    t=r["created_at"].replace("T"," ")[:16]
    print("%s %s UTC  %-11s %s" % (mark, t, st, r.get("display_title","")))'
  info "все сборки: https://github.com/$FARM_REPO/actions"
}

cmd_farm_log() {
  farm_init
  local id=${1:-}
  if [ -z "$id" ]; then farm_last_run_id; id=$RUN_ID; fi
  [ "${id:-0}" != 0 ] || die "сборок ещё не было"
  farm_show_log "$id"
  info "весь лог: https://github.com/$FARM_REPO/actions/runs/$id"
}

cmd_farm() {
  local sub=${1:-}; [ $# -gt 0 ] && shift
  case $sub in
    build|b)   cmd_farm_build "$@" ;;
    send)      cmd_farm_send "$@" ;;
    status|st) cmd_farm_status ;;
    log)       cmd_farm_log "$@" ;;
    token)     cmd_farm_token ;;
    *) die "creeper farm build|send|status|log|token (подробнее: creeper help)" ;;
  esac
}

cmd_list() {
  local d p n=0 why
  for d in "$DB"/*/; do
    [ -f "$d/version" ] || continue
    p=$(basename "$d"); n=$((n+1))
    why=; [ "$(cat "$d/reason" 2>/dev/null)" = dep ] && why="(зависимость)"
    printf '%-20s %-14s %-17s %s\n' "$p" "$(cat "$d/version")-$(inst_release "$p")" "$(cat "$d/date" 2>/dev/null)" "$why"
  done
  [ $n -gt 0 ] || info "пока ничего (базовая система LFS не учитывается)"
}

cmd_search() {
  local d p mark
  for d in "$RECIPES"/*/; do
    p=$(basename "$d"); [ -r "$d/recipe" ] || continue
    if [ -n "${1:-}" ]; then { echo "$p"; meta "$p" desc; } | grep -qi -- "$1" || continue; fi
    mark=; installed "$p" && mark="${CG}[установлен $(inst_version "$p")]${CN}"
    printf '%-16s %-12s %s %s\n' "$p" "$(meta "$p" version)" "$(meta "$p" desc)" "$mark"
  done
}

cmd_info() {
  local p=${1:?укажи пакет}
  have_recipe "$p" || installed "$p" || die "нет такого пакета: $p"
  echo "${CB}$p${CN}"
  if have_recipe "$p"; then
    echo "  описание:    $(meta "$p" desc)"
    echo "  в рецепте:   $(meta "$p" version)-$(pkgrel "$p")"
    echo "  зависит от:  $(meta "$p" depends | tr '\n' ' ')"
    echo "  сайт:        $(meta "$p" url)"
    local b="нет"
    [ -s "$BINCACHE/$(binfile "$p" "$(meta "$p" version)" "$(pkgrel "$p")")" ] && b="есть в кэше"
    [ "$b" = нет ] && [ -s "$WORK/index.txt" ] && awk -v n="$p" -v v="$(meta "$p" version)" '$1==n && $2==v' "$WORK/index.txt" | grep -q . && b="есть в репозитории"
    echo "  бинарник:    $b"
  fi
  if installed "$p"; then
    local sz
    sz=$(sed "s|^|$ROOT|" "$DB/$p/files" | xargs -d '\n' stat -c %s 2>/dev/null | awk '{s+=$1} END{printf "%.1f МБ", s/1048576}')
    echo "  установлен:  $(inst_version "$p")-$(inst_release "$p") ($(cat "$DB/$p/date")), $(cat "$DB/$p/reason" 2>/dev/null || echo explicit)"
    echo "  файлов:      $(wc -l < "$DB/$p/files"), размер $sz"
    local r; r=$(rdeps "$p" | tr '\n' ' '); echo "  нужен для:   ${r:--}"
  else
    echo "  не установлен"
  fi
}

cmd_files() { installed "${1:?укажи пакет}" || die "'$1' не установлен"; cat "$DB/$1/files"; }

cmd_owns() {
  local f=${1:?укажи файл} hit
  case $f in /*) ;; *) f=$(command -v -- "$f" 2>/dev/null || readlink -f -- "$f");; esac
  f=$(printf '%s\n' "$f" | normalize)
  hit=$(owners_index "" | awk -F'\t' -v f="$f" '$2==f{print $1}')
  if [ -n "$hit" ]; then echo "$f принадлежит пакету $CB$hit$CN"; else echo "$f — ничей (базовая LFS или поставлен вручную)"; fi
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case $cmd in
  install|i)        cmd_install "$@" ;;
  blow|b|remove)    cmd_blow "$@" ;;
  upgrade|up)       cmd_upgrade "$@" ;;
  autoremove)       cmd_autoremove "$@" ;;
  orphans)          cmd_orphans ;;
  fetch)            cmd_fetch "$@" ;;
  list|ls)          cmd_list ;;
  search|s)         cmd_search "$@" ;;
  info)             cmd_info "$@" ;;
  deps)             cmd_deps "$@" ;;
  files)            cmd_files "$@" ;;
  owns)             cmd_owns "$@" ;;
  verify|check)     cmd_verify "$@" ;;
  log)              cmd_log "$@" ;;
  history)          cmd_history "$@" ;;
  sync)             cmd_sync ;;
  farm)             cmd_farm "$@" ;;
  self-update)      cmd_self_update ;;
  clean)            cmd_clean "$@" ;;
  new)              cmd_new "$@" ;;
  pack)             cmd_pack "$@" ;;
  index)            cmd_index ;;
  version|--version|-V) echo "creeper $CREEPER_VERSION" ;;
  help|-h|--help)   usage ;;
  *) usage; exit 1 ;;
esac
